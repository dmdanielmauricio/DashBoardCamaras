<UserControl x:Class="ANPRViewer.Controls.CameraControlOpenCV"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Contenedor principal de la cámara -->
    <Border Background="#1E1E2E" BorderThickness="0" Margin="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Header -->
                <RowDefinition Height="*"/>
                <!-- Video -->
                <RowDefinition Height="Auto"/>
                <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- Header compacto con nombre de cámara -->
            <Border Grid.Row="0" Background="#1A1A2E" Padding="4,2">
                <Grid>
                    <TextBlock x:Name="CameraNameText" 
                               Text="Cámara" 
                               Foreground="White" 
                               FontWeight="Bold" 
                               FontSize="11"
                               HorizontalAlignment="Left" 
                               VerticalAlignment="Center"/>

                    <Ellipse x:Name="StatusIndicator" 
                             Width="8" Height="8" 
                             Fill="Red" 
                             HorizontalAlignment="Right" 
                             VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Video Player (aprovecha todo el espacio) -->
            <Image x:Name="CameraImage"
               Grid.Row="1"
               Stretch="UniformToFill"
               ClipToBounds="True"/>

            <!-- Overlay para cuando no hay video -->
            <Grid x:Name="NoVideoOverlay" 
                  Grid.Row="1" 
                  Background="#1E1E2E" 
                  Visibility="Visible">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="📷" 
                               FontSize="42" 
                               Foreground="#666" 
                               HorizontalAlignment="Center" 
                               Margin="0,0,0,6"/>
                    <TextBlock x:Name="OverlayText" 
                               Text="Sin conexión" 
                               Foreground="#888" 
                               FontSize="12" 
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="ErrorText" 
                               Text="" 
                               Foreground="#FF6B6B" 
                               FontSize="10" 
                               HorizontalAlignment="Center" 
                               Margin="0,4,0,0" 
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>

            <!-- Footer más pequeño -->
            <Border Grid.Row="2" Background="#1A1A2E" Padding="4,2" Height="20">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button x:Name="PlayPauseButton" 
                                Content="▶" 
                                Background="Transparent" 
                                Foreground="White" 
                                BorderThickness="0" 
                                Padding="2,0" 
                                FontSize="10"
                                Click="PlayPauseButton_Click" 
                                Cursor="Hand"/>
                        <Button x:Name="ReconnectButton" 
                                Content="🔄" 
                                Background="Transparent" 
                                Foreground="White" 
                                BorderThickness="0" 
                                Padding="2,0" 
                                FontSize="10"
                                Click="ReconnectButton_Click" 
                                Cursor="Hand"/>
                    </StackPanel>

                    <TextBlock x:Name="QualityText" 
                               Text="" 
                               Foreground="#888" 
                               FontSize="9" 
                               HorizontalAlignment="Right" 
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>

